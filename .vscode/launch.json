{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: .venv",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "env": {
                "FLASK_APP": "app/wsgi.py",
                "FLASK_DEBUG": "1",
                "FLASK_ENV": "development",
                "DB_HOST": "127.0.0.1",
                "CACHE_REDIS_HOST": "127.0.0.1",
                "CACHE_REDIS_PORT": "6379",
                "PYDEVD_USE_SYS_MONITORING": "False",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1",
                "LOCAL_DEV": "True",
            },
            "args": [
                "run",
                "--host",
                "127.0.0.1",
                "--port",
                "5000",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "justMyCode": true
        },
          {
      "name": "Python: Remote Attach (K8s reps-dev)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5558 },

      // Map your local repo folder to the container's /app
      // Your repo structure looks like: ~/repos/doSomeReps/app
      // The container uses /app (mounted hostPath).
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/app",
          "remoteRoot": "/app"
        }
      ],

      "justMyCode": false,
      "subProcess": true,           // important: Flask --reload spawns
      "redirectOutput": true,       // see server stdout in Debug Console
      "logToFile": false
    },
        {
            "name": "Python: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "0.0.0.0",
                "port": 6558
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/doSomeReps",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": false
        },
        {
            "name": "Attach to Flask",
            "type": "debugpy",
            "request": "attach",
             "connect": {
                "host": "0.0.0.0",
                "port": 5558
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                                        // "localRoot": "${workspaceFolder}/doSomeReps",
// 
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": false
        },

        
    ]
}


